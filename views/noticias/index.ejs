
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portal de Notícias - RAITEC</title>

    <link rel="stylesheet" href="/css/noticias.css">
</head>

<body>

    <!-- HEADER DINÂMICO -->
    <%- include('../partials/header') %>


    <main class="container">

        <!-- TÍTULO E PESQUISA -->
        <div class="topo-pagina">

            <h1>Portal de Notícias</h1>

            <div class="acoes">

                <form class="busca" action="/noticias" method="GET">

                    <input
                        type="search"
                        name="busca"
                        placeholder="BUSCAR"
                        aria-label="Buscar notícias"
                        value="<%= busca || '' %>"
                    >

                    <button type="submit" aria-label="Pesquisar">
                        ⌕
                    </button>

                </form>

                <a href="/login" class="btn-entrar">ENTRAR</a>

            </div>

        </div>


        <!-- VERIFICA SE EXISTEM NOTÍCIAS -->
        <% if (!noticias || noticias.length === 0) { %>

            <div class="sem-noticias">

                <h2>Nenhuma notícia encontrada</h2>

                <p>
                    <% if (busca) { %>
                        Não encontramos notícias para
                        "<%= busca %>".
                    <% } else { %>
                        Em breve teremos novidades por aqui!
                    <% } %>
                </p>

                <% if (busca) { %>
                    <a href="/noticias" class="mais">
                        Ver todas as notícias
                    </a>
                <% } %>

            </div>

        <% } else { %>


            <!-- SEPARAÇÃO DOS DESTAQUES -->
            <% const destaques = noticias.slice(0, 3); %>
            <% const restantes = noticias.slice(3); %>


            <!-- NOTÍCIAS EM DESTAQUE -->
            <section class="destaques">

                <!-- DESTAQUE PRINCIPAL -->
                <% if (destaques[0]) { %>

                    <a
                        href="/noticias/<%= destaques[0].slug || destaques[0].id %>"
                        class="noticia-principal"
                    >

                        <img
                            src="<%= destaques[0].imagem || '/imagens/noticia-padrao.png' %>"
                            alt="<%= destaques[0].nome || 'Notícia em destaque' %>"
                        >

                        <div class="noticia-principal-conteudo">

                            <span class="tag">DESTAQUE</span>

                            <h2>
                                <%= destaques[0].nome || 'Notícia sem título' %>
                            </h2>

                            <p>
                                <%= destaques[0].descricao || '' %>
                            </p>

                        </div>

                    </a>

                <% } %>


                <!-- DESTAQUES LATERAIS -->
                <div class="destaques-laterais">

                    <% destaques.slice(1).forEach(n => { %>

                        <a
                            href="/noticias/<%= n.slug || n.id %>"
                            class="noticia-destaque"
                        >

                            <img
                                src="<%= n.imagem || '/imagens/noticia-padrao.png' %>"
                                alt="<%= n.nome || 'Notícia' %>"
                            >

                            <div class="noticia-destaque-conteudo">

                                <span class="tag">NOTÍCIA</span>

                                <h3>
                                    <%= n.nome || 'Notícia sem título' %>
                                </h3>

                            </div>

                        </a>

                    <% }) %>

                </div>

            </section>


            <!-- CONTEÚDO PRINCIPAL -->
            <section class="conteudo">


                <!-- LISTA DE NOTÍCIAS -->
                <div class="lista-noticias">

                    <h2 class="titulo-lista">
                        <%= busca ? 'Resultados da pesquisa' : 'Últimas notícias' %>
                    </h2>


                    <% if (restantes.length === 0) { %>

                        <p class="mensagem-lista">
                            <% if (busca) { %>
                                Não há outras notícias para exibir nesta pesquisa.
                            <% } else { %>
                                Não há outras notícias para exibir no momento.
                            <% } %>
                        </p>

                    <% } %>


                    <% restantes.forEach(n => { %>

                        <a
                            href="/noticias/<%= n.slug || n.id %>"
                            class="item-noticia"
                        >

                            <img
                                src="<%= n.imagem || '/imagens/noticia-padrao.png' %>"
                                alt="<%= n.nome || 'Notícia' %>"
                                loading="lazy"
                            >

                            <div class="info">

                                <span class="tag">RAITEC</span>

                                <h3>
                                    <%= n.nome || 'Notícia sem título' %>
                                </h3>

                                <p>
                                    <%= n.descricao || '' %>
                                </p>


                                <!-- DATA DA PUBLICAÇÃO -->
                                <% if (n.data) { %>

                                    <time>
                                        <%
                                            const dataNoticia = n.data.toDate
                                                ? n.data.toDate()
                                                : new Date(n.data);

                                            if (!isNaN(dataNoticia.getTime())) {
                                        %>

                                            <%= dataNoticia.toLocaleDateString('pt-BR', {
                                                day: '2-digit',
                                                month: 'long',
                                                year: 'numeric'
                                            }) %>

                                        <% } %>
                                    </time>

                                <% } %>

                            </div>

                        </a>

                    <% }) %>

                </div>


                <!-- BARRA LATERAL -->
                <aside class="sidebar">

                    <h4>Viu Isso?</h4>

                    <ul>

                        <% noticias.slice(0, 4).forEach(n => { %>

                            <li>

                                <a href="/noticias/<%= n.slug || n.id %>">
                                    <%= n.nome || 'Notícia sem título' %>
                                </a>

                            </li>

                        <% }) %>

                    </ul>

                    <a href="/noticias" class="mais">
                        Mais notícias
                    </a>

                </aside>


            </section>

        <% } %>

    </main>


    <!-- FOOTER DINÂMICO -->
    <%- include('../partials/footer') %>


</body>
</html>
