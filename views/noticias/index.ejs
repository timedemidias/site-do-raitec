<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Notícias - RAITEC</title>
    <link rel="stylesheet" href="css/noticias.css">
</head>
<body>

  <%- include("../partials/header") %>

  <main class="container">
    <div class="topo-pagina">
      <h1>Portal de Notícias</h1>
      <div class="acoes">
        <div class="busca">
          <input type="text" placeholder="BUSCAR">
        </div>
        <button class="btn-entrar"> ENTRAR</button>
      </div>
    </div>


    <section class="destaques">
      <!-- NOTICIA PRINCIPAL -->
      <a href="noticia.html?id=0" class="noticia-principal">
           <img src="" alt=""> <!-- JS preenche -->
        <div class="noticia-principal-conteudo">
          <span class="tag"></span>
          <h2></h2>
          <p></p>
       </div>
      </a>



      <!-- 2 NOTICIAS DESTAQUE -->
      <div class="destaques-laterais">
        <a href="noticia.html?id=1" class="noticia-destaque">
          <img src="" alt=""> 
          <div class="noticia-destaque-conteudo">
            <span class="tag"></span>
            <h3></h3>
          </div>
        </a>
        
        <a href="noticia.html?id=2" class="noticia-destaque">
          <img src="" alt=""> 
          <div class="noticia-destaque-conteudo">
            <span class="tag"></span>
            <h3></h3>
          </div>
        </a>
      </div>

    </section>








    <section class="conteudo">
      <!-- LISTA DE NOTICIAS -->


      <div class="lista-noticias" id="lista-noticias">
          <ul>
        <% noticias.forEach(n => { %>
            <li>
            <a href="/noticias/<%= n.slug %>">

                <img src="/images/noticias/<%= n.imagem %>" alt="<%= n.nome %>">
                <strong><%= n.nome %></strong> 
                <p><%= n.data %></p>

            </a>
            </li>
        <% }) %>
        </ul>
      </div>




      <!-- BARRA LATERAL -->
      <aside class="sidebar">
        <h4>Viu Isso?</h4>
        <ul id="sidebar-lista">
          <!-- Itens via JS -->
        </ul>
        <a href="index.html" class="mais">Mais</a>
      </aside>
    </section>
  </main>







  <footer>
    <div class="container">
        <div class="footer-left">
        <img src="imagens/logo-footer.png" alt="RAITEC" class="footer-brand">
      <div class="footer-info">
        <p>© 2025 RAITEC — Todos os direitos reservados.</p>
        <p>Contato: <a href="mailto:raitec@ufc.br">raitec@ufc.br</a></p>
        </div>
    </div>

      <div class="footer-social">
      <a href="https://www.facebook.com/raitec.ufc/" title="Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
      </a>
      <a href="https://br.linkedin.com/company/raitec-ufc" title="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <a href="https://youtube.com/@rautecufc9945?si=SKym-AyV26X9_il" title="YouTube">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#0b1228"/></svg>
      </a>
      <a href="https://www.instagram.com/raitec.ufc/" title="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>

    </div>
  </footer>

