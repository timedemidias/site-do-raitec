<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= noticia.nome %> - RAITEC</title>
  <link rel="stylesheet" href="/css/noticias.css">
</head>
<body>

      <%- include('../partials/header') %>


  <main class="container">

    <div class="topo-pagina">
      <h1>Portal de Notícias</h1>

      <div class="acoes">
        <form class="busca" action="/noticias" method="GET">
          <input
            type="search"
            name="busca"
            placeholder="BUSCAR"
            aria-label="Buscar notícias"
          >
          <button type="submit" aria-label="Pesquisar">⌕</button>
        </form>

        <a href="/login" class="btn-entrar">ENTRAR</a>
      </div>
    </div>

    <div class="voltar-noticias">
      <a href="/noticias">← Voltar para notícias</a>
    </div>

    <section class="pagina-noticia">

      <article class="conteudo-noticia">

        <h2><%= noticia.nome %></h2>

        <p class="subtitulo">
          <%= noticia.descricao || '' %>
        </p>

        <div class="meta">
          <span>RAITEC</span>

          <% if (noticia.data) { %>
            <time><%= noticia.data %></time>
          <% } %>
        </div>

        <% if (noticia.imagem) { %>
          <figure class="imagem-noticia">
            <img
              src="<%= noticia.imagem %>"
              alt="<%= noticia.nome %>"
            >
          </figure>
        <% } %>

        <div class="texto">
          <% if (noticia.conteudo) { %>
            <p class="conteudo-texto"><%= noticia.conteudo %></p>
          <% } else { %>
            <p>O conteúdo desta notícia ainda não foi informado.</p>
          <% } %>
        </div>

        <a href="/noticias" class="btn-voltar">
          Voltar ao portal
        </a>

      </article>

      <aside class="sidebar">
        <h4>Viu Isso?</h4>

        <ul>
          <% outrasNoticias.forEach(n => { %>
            <li>
              <a href="/noticias/<%= n.slug %>">
                <%= n.nome %>
              </a>
            </li>
          <% }) %>
        </ul>

        <a href="/noticias" class="mais">Mais notícias</a>
      </aside>

    </section>

  </main>

  <footer>
    <div class="container footer-container">

      <div class="footer-left">
        <img
          src="/imagens/logo-footer.png"
          alt="RAITEC"
          class="footer-brand"
        >

        <div class="footer-info">
          <p>© 2026 RAITEC — Todos os direitos reservados.</p>
          <p>
            Contato:
            <a href="mailto:raitec@ufc.br">raitec@ufc.br</a>
          </p>
        </div>
      </div>

      <div class="footer-social">
        <a href="https://www.facebook.com/raitec.ufc/" aria-label="Facebook">Facebook</a>
        <a href="https://br.linkedin.com/company/raitec-ufc" aria-label="LinkedIn">LinkedIn</a>
        <a href="https://youtube.com/@rautecufc9945" aria-label="YouTube">YouTube</a>
        <a href="https://www.instagram.com/raitec.ufc/" aria-label="Instagram">Instagram</a>
      </div>

    </div>
  </footer>

</body>
</html>