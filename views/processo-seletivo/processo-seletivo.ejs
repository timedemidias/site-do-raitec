          </div>
        </article>

      </div>
    </div>
  </main>

  <!--Rodapé-->
   <%# ("../partials/footer") %>

  <script> 

/*Cronograma: contagem regressiva*/
const countdown = document.querySelector(".countdown");
if (countdown && countdown.dataset.alvo) {
  const alvo = new Date(countdown.dataset.alvo).getTime(); // data vem do EJS
  const pad = (n) => String(n).padStart(2, "0");
  const els = {
    dias: document.getElementById("cd-dias"),
    horas: document.getElementById("cd-horas"),
    min: document.getElementById("cd-min"),
    seg: document.getElementById("cd-seg"),
  };
  const atualizar = () => {
    const diff = Math.max(0, alvo - Date.now());
    els.dias.textContent = pad(Math.floor(diff / 86400000));
    els.horas.textContent = pad(Math.floor((diff % 86400000) / 3600000));
    els.min.textContent = pad(Math.floor((diff % 3600000) / 60000));
    els.seg.textContent = pad(Math.floor((diff % 60000) / 1000));
  };
  atualizar();
  setInterval(atualizar, 1000);
}

/* Cronograma: aviso dos resultados das etapas 1 a 4*/
document.querySelectorAll("[data-resultado]").forEach((btn) =>
  btn.addEventListener("click", () =>
    alert("Os resultados da etapa " + btn.dataset.resultado + " serão divulgados por e-mail ao candidato.")
  )
);

  </script>
</body>
</html>
