  <!--Rodapé-->
   <%# ("../partials/footer") %>

  <script>
  /*informacoes.ejs: destaca a seção vinda do link (#id)*/
function destacarSecao() {
  const id = location.hash.slice(1);
  const alvo = id && document.querySelector(".info-card#" + CSS.escape(id));
  if (!alvo) return;
  alvo.classList.add("highlight");
  setTimeout(() => alvo.classList.remove("highlight"), 1800);
}
if (document.querySelector(".info-card")) {
  destacarSecao();
  window.addEventListener("hashchange", destacarSecao);
}
  </script>
